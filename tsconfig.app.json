{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "types": ["vite/client"]
  },
  "exclude": [
    "libs/src/**/*.spec.ts",
    "libs/src/**/*.test.ts",
    "libs/src/**/*.spec.vue",
    "libs/src/**/*.test.vue",
    "**/*.stories.ts",
    "**/*.stories.js"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.vue"]
}
